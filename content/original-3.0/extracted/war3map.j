ilityBJ('A0AR',GetSpellAbilityUnit())set udg_TempPoi=GetUnitLoc(GetSpellTargetUnit())call IssuePointOrderByIdLoc(GetSpellAbilityUnit(),852125,udg_TempPoi)call RemoveLocation(udg_TempPoi)endifif(Trig_TZSSlongjuanfeng_Func003C())thencall UnitRemoveAbilityBJ('A0AQ',GetSpellAbilityUnit())call UnitAddAbilityBJ('A0AQ',GetSpellAbilityUnit())set udg_TempPoi=GetUnitLoc(GetSpellTargetUnit())call IssuePointOrderByIdLoc(GetSpellAbilityUnit(),852125,udg_TempPoi)call RemoveLocation(udg_TempPoi)endifendfunctionfunction InitTrig_TZSSlongjuanfeng takes nothing returns nothingset gg_trg_TZSSlongjuanfeng=CreateTrigger()call TriggerRegisterAnyUnitEventBJ(gg_trg_TZSSlongjuanfeng,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(gg_trg_TZSSlongjuanfeng,Condition(function Trig_TZSSlongjuanfeng_Conditions))call TriggerAddAction(gg_trg_TZSSlongjuanfeng,function Trig_TZSSlongjuanfeng_Actions)endfunctionfunction Trig_TZDZqiangjie_Conditions takes nothing returns booleanreturn(GetUnitTypeId(GetSpellAbilityUnit())=='h05U')and( not(udg_playerzz[GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))]!=3))endfunctionfunction Trig_TZDZqiangjie_Func001C takes nothing returns booleanreturn(GetSpellAbilityId()=='A0BF')endfunctionfunction Trig_TZDZqiangjie_Func002C takes nothing returns booleanreturn(GetSpellAbilityId()=='A0BE')endfunctionfunction Trig_TZDZqiangjie_Func003C takes nothing returns booleanreturn(GetSpellAbilityId()=='A0BG')endfunctionfunction Trig_TZDZqiangjie_Actions takes nothing returns nothingif(Trig_TZDZqiangjie_Func001C())thencall AdjustPlayerStateBJ(3,GetOwningPlayer(GetSpellAbilityUnit()),PLAYER_STATE_RESOURCE_GOLD)endifif(Trig_TZDZqiangjie_Func002C())thencall AdjustPlayerStateBJ(6,GetOwningPlayer(GetSpellAbilityUnit()),PLAYER_STATE_RESOURCE_GOLD)endifif(Trig_TZDZqiangjie_Func003C())thencall AdjustPlayerStateBJ(9,GetOwningPlayer(GetSpellAbilityUnit()),PLAYER_STATE_RESOURCE_GOLD)endifendfunctionfunction InitTrig_TZDZqiangjie takes nothing returns nothingset gg_trg_TZDZqiangjie=CreateTrigger()call TriggerRegisterAnyUnitEventBJ(gg_trg_TZDZqiangjie,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(gg_trg_TZDZqiangjie,Condition(function Trig_TZDZqiangjie_Conditions))call TriggerAddAction(gg_trg_TZDZqiangjie,function Trig_TZDZqiangjie_Actions)endfunctionfunction Trig_TZDZtoushu_Conditions takes nothing returns booleanreturn(GetUnitTypeId(GetAttacker())=='h05T')and( not(udg_playerzz[GetPlayerId(GetOwningPlayer(GetAttacker()))]!=3))endfunctionfunction Trig_TZDZtoushu_Func001C takes nothing returns booleanreturn(GetUnitUserData(GetAttacker())<udg_biaozhuncs[0])and(GetRandomInt(1,20)==1)endfunctionfunction Trig_TZDZtoushu_Func002C takes nothing returns booleanreturn(GetUnitUserData(GetAttacker())>=udg_biaozhuncs[0])and(GetUnitUserData(GetAttacker())<udg_biaozhuncs[1])and(GetRandomInt(1,10)==1)endfunctionfunction Trig_TZDZtoushu_Func003C takes nothing returns booleanreturn(GetUnitUserData(GetAttacker())>=udg_biaozhuncs[1])and(GetRandomInt(1,20)<=3)endfunctionfunction Trig_TZDZtoushu_Actions takes nothing returns nothingif(Trig_TZDZtoushu_Func001C())thencall AdjustPlayerStateBJ(((udg_waves+2)/3),GetOwningPlayer(GetAttacker()),PLAYER_STATE_RESOURCE_GOLD)endifif(Trig_TZDZtoushu_Func002C())thencall AdjustPlayerStateBJ(((udg_waves+2)/3),GetOwningPlayer(GetAttacker()),PLAYER_STATE_RESOURCE_GOLD)endifif(Trig_TZDZtoushu_Func003C())thencall AdjustPlayerStateBJ(((udg_waves+2)/3),GetOwningPlayer(GetAttacker()),PLAYER_STATE_RESOURCE_GOLD)endifendfunctionfunction InitTrig_TZDZtoushu takes nothing returns nothingset gg_trg_TZDZtoushu=CreateTrigger()call TriggerRegisterAnyUnitEventBJ(gg_trg_TZDZtoushu,EVENT_PLAYER_UNIT_ATTACKED)call TriggerAddCondition(gg_trg_TZDZtoushu,Condition(function Trig_TZDZtoushu_Conditions))call TriggerAddAction(gg_trg_TZDZtoushu,function Trig_TZDZtoushu_Actions)endfunctionfunction Trig_TZjianta_Addtx takes integer pid,integer i returns nothingcall AddLightningLoc(udg_sln[i],udg_Pointa,udg_Pointb)call StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","0",H2I(GetLastCreatedLightningBJ()))call AddLightningLoc(udg_sln[i],udg_Pointb,udg_Pointc)call StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","1",H2I(GetLastCreatedLightningBJ()))call AddLightningLoc(udg_sln[i],udg_Pointc,udg_Pointa)call StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","2",H2I(GetLastCreatedLightningBJ()))endfunctionfunction Trig_TZjianta_Deltx takes integer pid,integer i returns nothingcall DestroyLightning(I2L(GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","0")))call StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","0",0)call DestroyLightning(I2L(GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","1")))call StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","1",0)call DestroyLightning(I2L(GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","2")))call StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","2",0)endfunctionfunction Trig_TZjianta_jiance takes unit u,integer i returns booleanlocal real distanceif udg_yxmode==2 thenset distance=99999.elseset distance=1200.endifif(GetStoredInteger(udg_GC,udg_sp[GetPlayerId(GetOwningPlayer(u))]+"_"+udg_stz[i],"1")==0)thenreturn falseendifif(GetStoredInteger(udg_GC,udg_sp[GetPlayerId(GetOwningPlayer(u))]+"_"+udg_stz[i],"2")==0)thenreturn falseendifif(GetStoredInteger(udg_GC,udg_sp[GetPlayerId(GetOwningPlayer(u))]+"_"+udg_stz[i],"3")==0)thenreturn falseendifif(not(DistanceBetweenPoints(udg_Pointa,udg_Pointb)<=distance))thenreturn falseendifif(not(DistanceBetweenPoints(udg_Pointb,udg_Pointc)<=distance))thenreturn falseendifif(not(DistanceBetweenPoints(udg_Pointc,udg_Pointa)<=distance))thenreturn falseendifreturn trueendfunctionfunction Trig_TZjianta_Actions takes integer i,integer j returns nothinglocal integer pidlocal unit u=GetTriggerUnit()local unit u1=nulllocal unit u2=nulllocal unit u3=nullset pid=GetPlayerId(GetOwningPlayer(u))if udg_yxmode==2 thencall DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,30,"|c0000ff00套装炮塔不限制职业建造，但每种套装最多一套，并且相互之间距离都在|c00ff000099999码以内|c0000ff00时才能激活套装效果。")elsecall DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,30,"|c0000ff00套装炮塔只能由|c00ff0000对应的职业|c0000ff00建造，并且相互之间距离都在|c00ff00001200码以内|c0000ff00时才能激活套装效果。每个职业只能拥有一套套装。")endifcall StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i],I2S(j),H2I(u))set u1=I2U(GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i],"1"))set u2=I2U(GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i],"2"))set u3=I2U(GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i],"3"))set udg_Pointa=GetUnitLoc(u1)set udg_Pointb=GetUnitLoc(u2)set udg_Pointc=GetUnitLoc(u3)if(Trig_TZjianta_jiance(u,i))thencall StoreInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i],"0",1)call UnitAddAbilityBJ(udg_ab[i],u1)call UnitAddAbilityBJ(udg_ab[i],u2)call UnitAddAbilityBJ(udg_ab[i],u3)call Trig_TZjianta_Addtx(pid,i)call AddSpecialEffectLocBJ(udg_Pointa,udg_smn[i])call DestroyEffect(GetLastCreatedEffectBJ())call AddSpecialEffectLocBJ(udg_Pointb,udg_smn[i])call DestroyEffect(GetLastCreatedEffectBJ())call AddSpecialEffectLocBJ(udg_Pointc,udg_smn[i])call DestroyEffect(GetLastCreatedEffectBJ())call DisplayTimedTextToForce(GetPlayersAll(),20.,((("恭喜|c00ff0000"+GetPlayerName(GetOwningPlayer(u)))+"|r集齐了"+udg_sdistxt[i]+"！")))endifset u=nullset u1=nullset u2=nullset u3=nullcall RemoveLocation(udg_Pointa)call RemoveLocation(udg_Pointb)call RemoveLocation(udg_Pointc)endfunctionfunction Trig_TZjianta_Conditions takes nothing returns nothinglocal integer ilocal integer jset i=0loopexitwhen i>5set j=1loopexitwhen j>3if(GetUnitTypeId(GetTriggerUnit())==GetStoredInteger(udg_GC,udg_stz[i],I2S(j)))thenif udg_yxmode!=2 thenif udg_playerzz[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]!=(i+1)thenreturnendifendifif GetStoredInteger(udg_GC,udg_sp[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]+"_"+udg_stz[i],I2S(j))!=0 thenreturnendifif GetStoredInteger(udg_GC,udg_sp[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]+"_"+udg_stz[i],"0")!=0 thenreturnendifcall Trig_TZjianta_Actions(i,j)returnendifset j=j+1endloopset i=i+1endloopendfunctionfunction InitTrig_TZjianta takes nothing returns nothingset gg_trg_TZjianta=CreateTrigger()call TriggerRegisterAnyUnitEventBJ(gg_trg_TZjianta,EVENT_PLAYER_UNIT_UPGRADE_FINISH)call TriggerAddAction(gg_trg_TZjianta,function Trig_TZjianta_Conditions)endfunctionfunction Trig_shanc_Conditions takes nothing returns booleanreturn(udg_waves>10)endfunctionfunction Trig_shanc_001 takes nothing returns nothingcall RemoveItem(GetEnumItem())endfunctionfunction Trig_shanc_Actions takes nothing returns nothingcall DisplayTextToForce(GetPlayersAll(),(GetPlayerName(GetTriggerPlayer())+"|cffe55bb0清除了地上的物品!|r"))call EnumItemsInRectBJ(GetPlayableMapRect(),function Trig_shanc_001)endfunctionfunction InitTrig_shanc takes nothing returns nothingset gg_trg_shanc=CreateTrigger()call TriggerRegisterPlayerChatEvent(gg_trg_shanc,Player(0),"-q",true)call TriggerRegisterPlayerChatEvent(gg_trg_shanc,Player(1),"-q",true)call TriggerRegisterPlayerChatEvent(gg_trg_shanc,Player(2),"-q",true)call TriggerRegisterPlayerChatEvent(gg_trg_shanc,Player(3),"-q",true)call TriggerAddCondition(gg_trg_shanc,Condition(function Trig_shanc_Conditions))call TriggerAddAction(gg_trg_shanc,function Trig_shanc_Actions)endfunctionfunction Trig_guanbitx_Actions takes nothing returns nothinglocal boolean b=falselocal integer ilocal integer pid=GetPlayerId(GetTriggerPlayer())set i=0loopexitwhen i>5if GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i],"0")!=0 thenif GetStoredInteger(udg_GC,udg_sp[pid]+"_"+udg_stz[i]+"_lightning","0")!=0 thenset b=truecall Trig_TZjianta_Deltx(pid,i)endifendifset i=i+1endloopif b thencall DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00FFFF80关闭套装特效技能~|r")endif
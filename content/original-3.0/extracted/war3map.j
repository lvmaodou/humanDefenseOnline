Actions)endfunctionfunction Trig_jianjie_Actions takes nothing returns nothingcall CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"|c0000FF00修正版说明|r","基于人族无敌2.1a官方正式版(www.wow8.org)修改，加入多个模式选择。由于原图也存在的BUG，本修改版不给予解决，请等待原图作者更新。
修正快速模式下套装炮塔升级问题，套装物品掉落几率增加。
加入单机模式，多人联网时请勿开启：
开启方法按键盘上的方向键(↑↓←→)即可。","ReplaceableTextures\\CommandButtons\\BTNAvatarOff.blp")call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"|c0000FF002.1c重点更新|r","加入物品删除命令，10波后才能启用，输入-q
加入套装效果删除命令，输入-guanbi
恢复套装效果输入-kaiqi，其他一些小修复游戏中体验。","ReplaceableTextures\\CommandButtons\\BTNAvatarOff.blp")call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"|c0000FF00模式说明|r","正常模式就不用介绍了吧。
特殊模式：
可以任意组合，结合正常和快速升级模式，使难度多样变化。","ReplaceableTextures\\CommandButtons\\BTNAvatarOff.blp")call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"2.1a版更新内容","TRIGSTR_3566","ReplaceableTextures\\CommandButtons\\BTNAvatarOn.blp")call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"关键性提示","|c0000ff00☆|r所有炮塔技能快捷键均为R。
|c0000ff00☆|r降低了一些升级难度大的炮塔的升级难度。
|c0000ff00☆|r盗贼的扔钱技能改在小强身上，金钱数为0时只有25%的几率触发技能，而不是之前版本的100%。
|c0000ff00☆|r穿刺攻击对英雄甲和城墙甲均造成100%的伤害，可以说是最好的一种攻击方式了。
|c0000ff00☆|r套装炮塔能力提升后技能会停止自动释放，请及时操作。Lv3炮塔升级到LvMax时，技能也会停止自动释放。","ReplaceableTextures\\CommandButtons\\BTNAvatarOn.blp")call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"关于套装炮塔","|c0000ff00☆|r只有普通以上难度才会增加套装炮塔系统。
|c0000ff00☆|r杀死敌人有很小的几率掉落套装炮塔，难度越高几率越大。
|c0000ff00☆|r只有职业相符，并且炮塔之间距离均不超过1200码时才能激活套装效果。每个玩家只能拥有一套套装。收购的套装炮塔无法构成套装。
|c0000ff00☆|r发现任何bug请登陆http://bbs.wow8.org/人族无敌II专区提交，感谢您的支持。","ReplaceableTextures\\CommandButtons\\BTNAvatarOn.blp")endfunctionfunction InitTrig_jianjie takes nothing returns nothingset gg_trg_jianjie=CreateTrigger()call TriggerAddAction(gg_trg_jianjie,function Trig_jianjie_Actions)endfunctionfunction Trig_TZLRchanrao_Conditions takes nothing returns booleanreturn(GetUnitTypeId(GetSpellAbilityUnit())=='h05Q')endfunctionfunction Trig_TZLRchanrao_Func001C takes nothing returns booleanreturn(GetSpellAbilityId()=='A0B3')endfunctionfunction Trig_TZLRchanrao_Func002C takes nothing returns booleanreturn(GetSpellAbilityId()=='A0B4')endfunctionfunction Trig_TZLRchanrao_Func003C takes nothing returns booleanreturn(GetSpellAbilityId()=='A0B2')endfunctionfunction Trig_TZLRchanrao_Actions takes nothing returns nothingif(Trig_TZLRchanrao_Func001C())thencall UnitRemoveAbilityBJ('A010',GetSpellAbilityUnit())call UnitAddAbilityBJ('A010',GetSpellAbilityUnit())call IssueTargetOrderById(GetSpellAbilityUnit(),852171,GetSpellTargetUnit())endifif(Trig_TZLRchanrao_Func002C())thencall UnitRemoveAbilityBJ('A0B1',GetSpellAbilityUnit())call UnitAddAbilityBJ('A0B1',GetSpellAbilityUnit())call IssueTargetOrderById(GetSpellAbilityUnit(),852171,GetSpellTargetUnit())endifif(Trig_TZLRchanrao_Func003C())thencall UnitRemoveAbilityBJ('A0B0',GetSpellAbilityUnit())call UnitAddAbilityBJ('A0B0',GetSpellAbilityUnit())call IssueTargetOrderById(GetSpellAbilityUnit(),852171,GetSpellTargetUnit())endifendfunctionfunction InitTrig_TZLRchanrao takes nothing returns nothingset gg_trg_TZLRchanrao=CreateTrigger()call TriggerRegisterAnyUnitEventBJ(gg_trg_TZLRchanrao,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(gg_trg_TZLRchanrao,Condition(function Trig_TZLRchanrao_Conditions))call TriggerAddAction(gg_trg_TZLRchanrao,function Trig_TZLRchanrao_Actions)endfunctionfunction Trig_TZMJSzhaohuan_Conditions takes nothing returns booleanreturn(GetUnitTypeId(GetAttacker())=='h0
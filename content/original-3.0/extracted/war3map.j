56 thencall DestroyTimer(t)returnendifset udg_Pointa=GetRectCenter(gg_rct_a1)set udg_Pointb=GetRectCenter(gg_rct_b1)set udg_Pointc=GetRectCenter(gg_rct_c1)set udg_Pointd=GetRectCenter(gg_rct_d1)set i=1loopexitwhen i>udg_shuaguaishucall CreateUnitAtLoc(Player(8),udg_EnemyType[udg_waves],udg_Pointa,bj_UNIT_FACING)call CreateUnitAtLoc(Player(9),udg_EnemyType[udg_waves],udg_Pointb,bj_UNIT_FACING)call CreateUnitAtLoc(Player(10),udg_EnemyType[udg_waves],udg_Pointc,bj_UNIT_FACING)call CreateUnitAtLoc(Player(11),udg_EnemyType[udg_waves],udg_Pointd,bj_UNIT_FACING)set i=i+1endloopcall RemoveLocation(udg_Pointa)call RemoveLocation(udg_Pointb)call RemoveLocation(udg_Pointc)call RemoveLocation(udg_Pointd)set udg_shuabingcount=udg_shuabingcount+1if udg_waves>44 thenif udg_shuabingcount>=40 thenset udg_shuabingcount=0call DestroyTimer(t)if(ModuloInteger(udg_waves,10)==0)thencall InitTrig_NextRound_1_boss()endifif udg_waves==56 thencall InitTrig_NextRound_2_boss()endifendifelseif udg_shuabingcount>=40 thenset udg_shuabingcount=0call DestroyTimer(t)if(ModuloInteger(udg_waves,10)==0)thencall InitTrig_NextRound_1_boss()endifendifendifendfunctionfunction InitTrig_EveryRound1 takes nothing returns nothinglocal timer tm=CreateTimer()call TimerStart(tm,.8,true,function Trig_EveryRound_Actions)set tm=nullendfunctionfunction InitTrig_EveryRound2 takes nothing returns nothinglocal timer tm=CreateTimer()call TimerStart(tm,1.,true,function Trig_EveryRound_Actions)set tm=nullendfunctionfunction Trig_NextRound_shangqian takes nothing returns booleanreturn(ModuloInteger(udg_waves,7)==0)and(udg_waves<=28)endfunctionfunction Trig_NextRound_gaolidai1 takes nothing returns booleanreturn(udg_j>(GetPlayerState(ConvertedPlayer(GetForLoopIndexA()),PLAYER_STATE_RESOURCE_GOLD)/10))endfunctionfunction Trig_NextRound_gaolidai2 takes nothing returns booleanreturn(udg_gaolidai[GetForLoopIndexA()])and(udg_waves>40)endfunctionfunction Trig_NextRound_faqian takes nothing returns nothinglocal integer tif udg_yxmode==2thenset t=R2I(((udg_waves*6)+50)*1.5)elseset t=(udg_waves*6)+50endifcall AdjustPlayerStateBJ(t,GetEnumPlayer(),PLAYER_STATE_RESOURCE_GOLD)call DisplayTimedTextToPlayer(GetEnumPlayer(),0,0,10.,(("赏钱了，你得到|c00ffff00"+I2S(t))+"|r金"))endfunctionfunction Trig_NextRound takes nothing returns nothinglocal timer tm=GetExpiredTimer()set udg_waves=(udg_waves+1)if udg_waves>56 thencall DestroyTimer(tm)elseif udg_waves<56 thencall TimerDialogDisplayBJ(true,udg_twaves)call TimerDialogSetTitle(udg_twaves,("|c00FF0000"+(I2S((udg_waves+1))+"|r/56 波")))endifif(Trig_NextRound_shangqian())thencall AdjustPlayerStateBJ(((udg_waves*'d')/7),LeaderboardGetIndexedPlayerBJ(4,GetLastCreatedLeaderboard()),PLAYER_STATE_RESOURCE_GOLD)call DisplayTextToPlayer(LeaderboardGetIndexedPlayerBJ(4,GetLastCreatedLeaderboard()),0,0,("|c0000ff00由于你杀敌太少，雅典娜十分欣慰，贿赂你|c00ff0000"+(I2S(((udg_waves*'d')/7))+"|c0000ff00点金币，希望你继续保持^_^")))endifif(udg_waves==40)thencall TriggerExecute(gg_trg_Lv1Delete)endifset bj_forLoopAIndex=1set bj_forLoopAIndexEnd=5loopexitwhen bj_forLoopAIndex>bj_forLoopAIndexEndif(Trig_NextRound_gaolidai2())thenset udg_j=4000if(Trig_NextRound_gaolidai1())thenset udg_j=(GetPlayerState(ConvertedPlayer(GetForLoopIndexA()),PLAYER_STATE_RESOURCE_GOLD)/10)endifcall DisplayTimedTextToForce(GetPlayersAll(),15.,((GetPlayerName(ConvertedPlayer(GetForLoopIndexA()))+"获得了|c00ff0000")+(I2S(udg_j)+"|r点高利贷利息~真让人眼红^_^")))call AdjustPlayerStateBJ(udg_j,ConvertedPlayer(GetForLoopIndexA()),PLAYER_STATE_RESOURCE_GOLD)endifset bj_forLoopAIndex=bj_forLoopAIndex+1endloopif udg_waves==45 thencall DestroyTimerDialog(udg_twaves)call DestroyTimer(tm)set udg_twaves=nullset tm=nullcall ExecuteFunc("fun_NextRound2")endifif udg_waves>44 thencall InitTrig_EveryRound2()elsecall InitTrig_EveryRound1()endifset udg_Pointd=GetRectCenter(gg_rct_d1)call CreateNUnitsAtLoc(1,udg_EnemyType[udg_waves],Player(8),udg_Pointd,bj_UNIT_FACING)call RemoveLocation(udg_Pointd)call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,((("Level "+I2S(udg_waves))+" |c00ffff00")+GetUnitName(GetLastCreatedUnit())))call RemoveUnit(GetLastCreatedUnit())if udg_waves!=1 thencall ForForce(GetPlayersAllies(Player(0)),function Trig_NextRound_faqian)endifendifendfunctionfunction fun_NextRound takes nothing returns nothinglocal timer tm=CreateTimer()if udg_twaves!=null thencall DestroyTimerDialog(udg_twaves)endifset udg_twaves=CreateTimerDialogBJ(tm,("|c00FF0000"+(I2S((udg_waves+1))+"|r/56 波")))call TimerDialogDisplayBJ(true,udg_twaves)call TimerStart(tm,60.,true,function Trig_NextRound)set tm=nullendfunctionfunction fun_NextRound2 takes nothing returns nothinglocal timer tm=CreateTimer()if udg_twaves!=null thencall DestroyTimerDialog(udg_twaves)endifset udg_twaves=CreateTimerDialogBJ(tm,("|c00FF0000"+(I2S((udg_waves+1))+"|r/56 波")))call TimerDialogDisplayBJ(true,udg_twaves)call TimerStart(tm,80.,true,function Trig_NextRound)set tm=nullendfunctionfunction fun_FirstRound_Actions takes nothing returns nothinglocal timer tm=GetExpiredTimer()call Trig_NextRound()call fun_NextRound()call DestroyTimer(tm)set tm=nullendfunctionfunction fun_FirstRound takes nothing returns nothinglocal timer tm=CreateTimer()if udg_twaves!=null thencall DestroyTimerDialog(udg_twaves)endifset udg_twaves=CreateTimerDialogBJ(tm,"edit by archcarol")call TimerDialogDisplayBJ(true,udg_twaves)call TimerDialogSetTitle(udg_twaves,("|c00FF0000"+(I2S((udg_waves+1))+"|r/56 波")))call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,"|c00FFFF00第一波怪物30秒后到达|r")call TimerStart(tm,30.,false,function fun_FirstRound_Actions)set tm=nullendfunctionfunction Trig_Defeated_Conditions takes nothing returns booleanreturn(udg_lives<=0)endfunctionfunction Trig_Defeated_Func003A takes nothing returns nothingcall CustomDefeatBJ(GetEnumPlayer(),("|c00FFFF00胜败乃兵家常事，大虾请重新来过！|n            |c0000ff00当前第|c00ff0000"+(
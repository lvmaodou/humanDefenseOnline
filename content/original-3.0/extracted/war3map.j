IT_SPELL_CAST)call TriggerAddCondition(gg_trg_DZsuoding,Condition(function Trig_DZsuoding_Conditions))call TriggerAddAction(gg_trg_DZsuoding,function Trig_DZsuoding_Actions)endfunctionfunction Trig_DZbaijia1_Func001Func001C takes nothing returns booleanreturn(udg_baijia[udg_E])endfunctionfunction Trig_DZbaijia1_Actions takes nothing returns nothingset udg_E=1loopexitwhen udg_E>4if(Trig_DZbaijia1_Func001Func001C())thencall AdjustPlayerStateBJ(-1,ConvertedPlayer(udg_E),PLAYER_STATE_RESOURCE_GOLD)endifset udg_E=udg_E+1endloopendfunctionfunction InitTrig_DZbaijia1 takes nothing returns nothingset gg_trg_DZbaijia1=CreateTrigger()call TriggerRegisterTimerEventPeriodic(gg_trg_DZbaijia1,.5)call TriggerAddAction(gg_trg_DZbaijia1,function Trig_DZbaijia1_Actions)endfunctionfunction Trig_DZzhiyu_Conditions takes nothing returns booleanreturn(GetSpellAbilityId()=='A08Q')and(GetUnitTypeId(GetSpellAbilityUnit())=='h046')endfunctionfunction Trig_DZzhiyu_Actions takes nothing returns nothingset udg_zhiyu=(1+ModuloInteger(GetPlayerState(GetOwningPlayer(GetSpellAbilityUnit()),PLAYER_STATE_RESOURCE_GOLD),7))set udg_lives=(udg_lives+udg_zhiyu)call DisplayTimedTextToForce(GetPlayersAll(),15.,((GetPlayerName(GetOwningPlayer(GetSpellAbilityUnit()))+"的一名|c0000ff00扒手(Lv3)|r牺牲自己，使人类提高了|c00ff0000")+(I2S(udg_zhiyu)+"|r点生命^_^")))call KillUnit(GetSpellAbilityUnit())call DisplayTimedTextToForce(GetPlayersAll(),10.,("还剩下"+(I2S(udg_lives)+"|r点生命~")))call LeaderboardSetPlayerItemValueBJ(Player(10),GetLastCreatedLeaderboard(),udg_lives)endfunctionfunction InitTrig_DZzhiyu takes nothing returns nothingset gg_trg_DZzhiyu=CreateTrigger()call DisableTrigger(gg_trg_DZzhiyu)call TriggerRegisterAnyUnitEventBJ(gg_trg_DZzhiyu,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(gg_trg_DZzhiyu,Condition(function Trig_DZzhiyu_Conditions))call TriggerAddAction(gg_trg_DZzhiyu,function Trig_DZzhiyu_Actions)endfunctionfunction Trig_DZshentou1_Conditions takes nothing returns 
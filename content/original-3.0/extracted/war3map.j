argetOrderById(GetLastCreatedUnit(),852095,GetEnumUnit())if(Trig_YXBingfengqiu_Func008Func001Func005C())thencall AddSpecialEffectTargetUnitBJ("origin",GetEnumUnit(),"Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")call DestroyEffect(GetLastCreatedEffectBJ())endifcall UnitApplyTimedLifeBJ(.5,'BTLF',GetLastCreatedUnit())call UnitDamageTarget(udg_SFHero,GetEnumUnit(),((I2R(udg_weili)/1.)*(I2R(udg_Kills[GetConvertedPlayerId(GetOwningPlayer(udg_SFHero))])*I2R(udg_waves))),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_LIGHTNING,WEAPON_TYPE_WHOKNOWS)call UnitDamageTarget(udg_SFHero,GetEnumUnit(),30000.,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)endifendfunctionfunction Trig_YXBingfengqiu_Actions takes nothing returns nothingset udg_SFHero=GetSpellAbilityUnit()set udg_TempPoi=GetUnitLoc(GetSpellAbilityUnit())set udg_PointE=GetUnitLoc(GetSpellTargetUnit())if(Trig_YXBingfengqiu_Func005C())thenset udg_weili=4elseset udg_weili=1endifset udg_TempGro=GetUnitsInRangeOfLocMatching(900.,udg_PointE,Condition(function Trig_YXBingfengqiu_Func006002003))set udg_i=0call ForGroupBJ(udg_TempGro,function Trig_YXBingfengqiu_Func008A)call RemoveLocation(udg_TempPoi)call GroupClear(udg_TempGro)endfunctionfunction InitTrig_YXBingfengqiu takes nothing returns nothingset gg_trg_YXBingfengqiu=CreateTrigger()call DisableTrigger(gg_trg_YXBingfengqiu)call TriggerRegisterAnyUnitEventBJ(gg_trg_YXBingfengqiu,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(gg_trg_YXBingfengqiu,Condition(function Trig_YXBingfengqiu_Conditions))call TriggerAddAction(gg_trg_YXBingfengqiu,function Trig_YXBingfengqiu_Actions)endfunctionfunction Trig_DZshentouA_Conditions takes nothing returns booleanreturn(GetUnitTypeId(udg_nongming[GetConvertedPlayerId(GetTriggerPlayer())])=='h000')endfunctionfunction Trig_DZshentouA_Actions takes nothing returns nothingset udg_shentou=truecall DisplayTextToPlayer(GetTriggerPlayer(),0,0,"关闭神偷技能~")endfunctionf
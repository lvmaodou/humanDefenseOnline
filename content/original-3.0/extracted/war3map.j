SetUnitPositionLoc(udg_nongming[3],GetRectCenter(gg_rct_ra3))call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ra3),"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl")call DestroyEffect(GetLastCreatedEffectBJ())call SetUnitPositionLoc(udg_nongming[4],GetRectCenter(gg_rct_ra4))call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ra4),"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl")call DestroyEffect(GetLastCreatedEffectBJ())call SetUnitPositionLoc(udg_nongming[5],GetRectCenter(gg_rct_ra5))call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ra5),"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl")call DestroyEffect(GetLastCreatedEffectBJ())call PolledWait(1.)if(Trig_Victory_Func022C())thencall TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[1],"小强甲",null,"雅典娜你个小样的，敢欺负我们人类，看我们小强怎么收拾你~",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hjai_0009,"堕落的雅典娜",null,"大哥大姐小强小小强们，行行好吧~看我这么靓，你们怎么忍心下得了手呢~",bj_TIMETYPE_ADD,0,true)set bj_forLoopAIndex=1set bj_forLoopAIndexEnd=5loopexitwhen bj_forLoopAIndex>bj_forLoopAIndexEndcall IssueTargetOrderById(udg_nongming[GetForLoopIndexA()],851983,gg_unit_Hjai_0009)set bj_forLoopAIndex=bj_forLoopAIndex+1endloopcall TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[2],"小强乙",null,"俺们都还没成年，你就用这招，太毒了吧……小强兄弟们快点把他砍了~就是这招搞得我们国王哈迪斯神魂颠倒的……",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hjai_0009,"堕落的雅典娜",null,"既然你们不懂得怜香惜玉~那我就不客气了~就凭你们几个小样~哈哈~",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hjai_0009,"堕落的雅典娜",null,"嗯……奇怪了~你们用的什么兵器~怎么就没见过呢？",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[3],"小强丙",null,"连菜刀都不知道？？真是没见过世面……",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hjai_0009,"堕落的雅典娜",null,"菜刀？？？难道是传说中的神器吗？(完蛋了，今天看来是我的忌日了啊……)",bj_TIMETYPE_ADD,0,true)call DisplayTimedTextToForce(GetPlayersAll(),10.,"雅典娜越想越害怕，心跳加速……加速，终于啊的一声~挂掉了~")call PolledWait(1.)call KillUnit(gg_unit_Hjai_0009)call PolledWait(5.)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[4],"小强丁",null,"俺们拿不起斧头才拿菜刀砍的……没想到菜刀这么强啊~",bj_TIMETYPE_ADD,0,true)call DisplayTimedTextToForce(GetPlayersAll(),10.,"从此以后，菜刀砍死雅典娜的传说就这样流传开了……")call PolledWait(5.)call CinematicModeBJ(false,GetPlayersAll())call PolledWait(1.)call ForForce(GetPlayersAllies(Player(0)),function Trig_Victory_Func022Func029A)elsecall TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[1],"小强甲",null,"咦？雅典娜这妞跑哪去了~",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[2],"小强乙",null,"不知道是哪位高手整死她了啊^_^",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_Hjai_0009,"雅典娜的冤魂",null,"我死的好惨~我做鬼也不会放过你们的~",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[3],"小强丙",null,"呵呵~幸亏你死得早~要是死在俺们手里~那才悲惨呢~",bj_TIMETYPE_ADD,0,true)call TransmissionFromUnitWithNameBJ(GetPlayersAll(),udg_nongming[4],"小强丁",null,"的确是啊~呵呵~至于为什么恐怕只有电视机前的观众朋友们能明白了o(∩_∩)o",bj_TIMETYPE_ADD,0,true)call DisplayTimedTextToForce(GetPlayersAll(),10.,"从此以后，雅典娜的冤魂一直飘荡在地狱最深处……")call PolledWait(5.)call CinematicModeBJ(false,GetPlayersAll())call PolledWait(1.)call ForForce(GetPlayersAllies(Player(0)),function Trig_Victory_Func022Func010A)endifendfunctionfunction InitTrig_Victory takes nothing returns nothingset gg_trg_Victory=CreateTrigger()call TriggerRegisterTimerEventPeriodic(gg_trg_Victory,5.)call TriggerAddCondition(gg_trg_Victory,Condition(function Trig_Victory_Conditions))call TriggerAddAction(gg_trg_Victory,function Trig_Victory_Actions)endfunctionfunction Trig_Boss_Dead_Conditions takes nothing returns booleanreturn(IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)!=null)endfunctionfunction Trig_Boss_Dead_Actions takes nothing returns nothingcall AdjustPlayerStateBJ(5,GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_FOOD_CAP)call DisplayTimedTextToForce(GetPlayersAll(),15.,(GetPlayerName(GetOwningPlayer(GetKillingUnitBJ()))+"消灭了一名|c00FF0000Boss|r，奖励5个人口~"))endfunctionfunction InitTrig_Boss_Dead takes nothing returns nothingset gg_trg_Boss_Dead=CreateTrigger()call TriggerRegisterPlayerUnitEventSimple(gg_trg_Boss_Dead,Player(8),EVENT_PLAYER_UNIT_DEATH)call TriggerRegisterPlayerUnitEventSimple(gg_trg_Boss_Dead,Player(9),EVENT_PLAYER_UNIT_DEATH)call TriggerRegisterPlayerUnitEventSimple(gg_trg_Boss_Dead,Player(10),EVENT_PLAYER_UNIT_DEATH)call TriggerRegisterPlayerUnitEventSimple(gg_trg_Boss_Dead,Player(11),EVENT_PLAYER_UNIT_DEATH)call TriggerAddCondition(gg_trg_Boss_Dead,Condition(function Trig_Boss_Dead_Conditions))call TriggerAddAction(gg_trg_Boss_Dead,function Trig_Boss_Dead_Actions)endfunctionfunction Trig_Set_Enemies_Actions takes nothing returns nothingset udg_i=1set udg_EnemyType[udg_i]='nanc'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nano'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nban'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nbld'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nbdm'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nbdo'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='ncer'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='ncnk'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nscb'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nsc3'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='ugar'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='unec'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='ucry'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='umtw'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nrdk'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nbzd'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nndr'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nrel'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nelb'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nenc'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='ners'set udg_i=(udg_i+1)set udg_EnemyType[udg_i]='nfot'set udg_i=(udg_i+1)s